<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        miuix-blur 声明 minSdk 33（内部用 android.graphics.RuntimeShader，API 33 才有）。
        我们只在 isRuntimeShaderSupported() 为 true 时才走模糊/折射，低版本自动回落到
        普通 FloatingNavigationBar，因此这里放开合并检查。
    -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur,top.yukonga.miuix.kmp.shader" />

    <!-- 只允许本 App 触发模块执行重启 -->
    <permission
        android:name="${applicationId}.permission.REBOOT"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.REBOOT" />

    <!-- 读取当前网络类型（Wi-Fi / 移动数据） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 仅用于在应用选择器里列出全部已安装应用 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VpnAutoSwitch">

        <!-- ===== LSPosed 模块声明 ===== -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <!-- 推荐作用域：只需要系统框架 -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!-- 设置入口：桌面图标被隐藏后，LSPosed 管理器里的「打开」是唯一入口，
             所以这条 MODULE_SETTINGS 必须留在 Activity 本身，不能跟着 alias 一起禁用 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 桌面入口：隐藏图标只禁用这个 alias，MainActivity 本身不受影响。
             name 用完整类名（这里 namespace 与 applicationId 不同，写相对名容易踩空），
             需与 LauncherIcon.ALIAS_CLASS 一致 -->
        <activity-alias
            android:name="com.vpnautoswitch.module.LauncherEntry"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 卸载清理：目标应用被删除后自动从配置里移除，重装回来默认关闭 -->
        <receiver
            android:name=".PackageRemovedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- 快捷设置磁贴：暂停 / 恢复自动联动 -->
        <service
            android:name=".VpnTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_vpn"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- 供 system_server 里的模块进程读取配置（只读，无敏感数据） -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="${applicationId}.config"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!--
            空服务：模块在开机时 startService 它，把本进程拉起来，好让上面的 provider 可查。
            不导出，只有 system_server（同一进程发起的组件启动）能调。
        -->
        <service
            android:name=".ConfigSyncService"
            android:exported="false" />
    </application>
</manifest>
